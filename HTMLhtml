<script>
"use strict";
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
/* ---------- saved state ---------- */
let P={done:[],learned:[],best:null,solves:0,moves:0,quiz:0,dark:true,mute:false,ms:260};
try{Object.assign(P,JSON.parse(localStorage.getItem('rc')||'{}'))}catch(e){}
const save=()=>{try{localStorage.setItem('rc',JSON.stringify(P))}catch(e){}};
/* ---------- cube maths (CSS coords: x right, y down, z toward viewer) ---------- */
const COL={U:'#fd0',D:'#fff',F:'#2c5',B:'#27f',R:'#f80',L:'#e33'};
const NRM={U:[0,-1,0],D:[0,1,0],F:[0,0,1],B:[0,0,-1],R:[1,0,0],L:[-1,0,0]};
const FT={F:'',B:'rotateY(180deg)',R:'rotateY(90deg)',L:'rotateY(-90deg)',U:'rotateX(90deg)',D:'rotateX(-90deg)'};
const MV={R:['x',[1],1],L:['x',[-1],-1],U:['y',[-1],-1],D:['y',[1],1],F:['z',[1],1],B:['z',[-1],-1],r:['x',[0,1],1],l:['x',[-1,0],-1],u:['y',[-1,0],-1],d:['y',[0,1],1],f:['z',[0,1],1],b:['z',[-1,0],-1],M:['x',[0],-1],E:['y',[0],1],S:['z',[0],1],x:['x',[-1,0,1],1],y:['y',[-1,0,1],-1],z:['z',[-1,0,1],1]}; // axis, layers, clockwise sign (wide, slice and whole-cube moves included)
const I3=[[1,0,0],[0,1,0],[0,0,1]];
const mul=(a,b)=>a.map(r=>[0,1,2].map(j=>r[0]*b[0][j]+r[1]*b[1][j]+r[2]*b[2][j]));
const mv3=(m,v)=>m.map(r=>r[0]*v[0]+r[1]*v[1]+r[2]*v[2]);
const rot=(ax,a)=>{const c=Math.cos(a),s=Math.sin(a);return ax=='x'?[[1,0,0],[0,c,-s],[0,s,c]]:ax=='y'?[[c,0,s],[0,1,0],[-s,0,c]]:[[c,-s,0],[s,c,0],[0,0,1]]};
const inv=m=>m[1]=="'"?m[0]:m[1]=='2'?m:m[0]+"'";
const invAlg=a=>a.split(/\s+/).reverse().map(inv).join(' ');
const rng=s=>()=>((s=Math.imul(s,1664525)+1013904223>>>0)/4294967296);
let ac;function beep(){if(P.mute)return;try{ac=ac||new AudioContext();const o=ac.createOscillator(),g=ac.createGain();o.connect(g);g.connect(ac.destination);o.frequency.value=380+Math.random()*80;g.gain.value=.04;o.start();o.stop(ac.currentTime+.05)}catch(e){}}

class Cube{
 constructor(el,S){this.S=S;this.rx=-28;this.ry=-38;this.q=Promise.resolve();this.hist=[];this.cs=[];
  this.root=document.createElement('div');this.root.className='cube';el.classList.add('stage');el.append(this.root);
  for(let x=-1;x<2;x++)for(let y=-1;y<2;y++)for(let z=-1;z<2;z++){if(!x&&!y&&!z)continue;
   const e=document.createElement('div'),c={o:[x,y,z],st:{},e};e.className='cb';e.style.cssText=`width:${S}px;height:${S}px;left:${-S/2}px;top:${-S/2}px`;
   for(const f in NRM){const d=document.createElement('div'),n=NRM[f];d.className='f';
    if(n[0]*x+n[1]*y+n[2]*z==1){d.style.background=COL[f];c.st[f]=COL[f]} // outward-facing sticker
    d.style.transform=`${FT[f]} translateZ(${S/2}px)`;e.append(d)}
   this.root.append(e);this.cs.push(c)}
  this.reset();this.view();
  let px,py,dn=0;el.addEventListener('pointerdown',e=>{dn=1;px=e.clientX;py=e.clientY;el.setPointerCapture&&el.setPointerCapture(e.pointerId)});
  el.addEventListener('pointerup',()=>dn=0);el.addEventListener('pointercancel',()=>dn=0);
  el.addEventListener('pointermove',e=>{if(!dn)return;this.ry+=(e.clientX-px)*.6;this.rx-=(e.clientY-py)*.6;px=e.clientX;py=e.clientY;this.view()})}
 view(){this.root.style.transform=`rotateX(${this.rx}deg) rotateY(${this.ry}deg)`}
 reset(){this.q=Promise.resolve();this.hist=[];this.task=null;this.cs.forEach(c=>{c.m=I3;c.p=[...c.o];this.put(c)})}
 put(c,m=c.m,p=c.p){const S=this.S;c.e.style.transform=`matrix3d(${m[0][0]},${m[1][0]},${m[2][0]},0,${m[0][1]},${m[1][1]},${m[2][1]},0,${m[0][2]},${m[1][2]},${m[2][2]},0,${p[0]*S},${p[1]*S},${p[2]*S},1)`}
 turn(mv,o={}){return this.q=this.q.then(()=>this._t(mv,o))}
 play(str,o){str.trim().split(/\s+/).forEach(m=>this.turn(m,o));return this.q}
 _t(mv,{rec=true,ms=P.ms}){return new Promise(res=>{
  const [ax,lay,sg]=MV[mv[0]],k=mv[1]=="'"?-1:mv[1]=='2'?2:1,i='xyz'.indexOf(ax),tot=sg*k*Math.PI/2,
   ls=this.cs.filter(c=>lay.includes(c.p[i])),t0=performance.now();
  if(ms&&this.S>30)beep();
  const fin=()=>{const R=rot(ax,tot);ls.forEach(c=>{c.m=mul(R,c.m).map(r=>r.map(Math.round));c.p=mv3(R,c.p).map(Math.round);this.put(c)});
   if(rec){this.hist.push(mv);this.onmove&&this.onmove(mv)}res()};
  const step=t=>{const f=ms?Math.max(0,Math.min(1,(t-t0)/(ms*(k==2?1.4:1)))):1;if(f>=1)return fin();
   const R=rot(ax,tot*(1-Math.pow(1-f,2)));ls.forEach(c=>this.put(c,mul(R,c.m),mv3(R,c.p)));requestAnimationFrame(step)};
  ms?requestAnimationFrame(step):fin()})}
 undo(){const m=this.hist.pop();if(m)this.turn(inv(m),{rec:false})}
 gen(n,r=Math.random){const s=[];let l='';while(s.length<n){const f='RLUDFB'[r()*6|0];if(f!=l){l=f;s.push(f+['',"'",'2'][r()*3|0])}}return s}
 solved(){const f={};for(const c of this.cs)for(const k in c.st){const n=mv3(c.m,NRM[k]).join();(f[n]=f[n]||new Set).add(c.st[k])}return Object.values(f).every(s=>s.size==1)}
}
/* ---------- content ---------- */
const LS=[
['Chapter 1','What is a 3×3 Cube?',`<p>The 3×3 Rubik’s Cube has <b>6 faces</b> of 9 stickers each. Solved means every face is one solid colour. Yellow is opposite white, green opposite blue, red opposite orange.</p><p>You don’t memorise 43 quintillion positions: a few short <b>algorithms</b> (fixed move sequences) solve it layer by layer. Drag the cube to look around.</p>`,0,'Hold the cube with white on the bottom and yellow on top – the cube here starts that way.','Never peel stickers or pull pieces apart: only turn the layers.'],
['Chapter 1','Pieces & Structure',`<p><b>6 centres</b> – one colour, fixed to the core. They never move relative to each other, so they decide each face’s colour.</p><p><b>12 edges</b> – two colours. <b>8 corners</b> – three colours.</p><p>Terms: <b>layer</b> (a 3×3 slice), <b>algorithm</b>, <b>scramble</b>, <b>orient</b> (twist a piece correctly), <b>permute</b> (move it to the right place).</p>`,0,'6 centres + 12 edges + 8 corners = 26 visible pieces.','Trying to move a centre – match everything to the centres instead.'],
['Chapter 2','Cube Notation',`<p>Each letter turns one face <b>clockwise as you look at that face</b>: <code>R</code> right, <code>L</code> left, <code>U</code> up, <code>D</code> down, <code>F</code> front, <code>B</code> back.</p><p>An apostrophe (<code>R'</code>, “R prime”) is counter-clockwise. A 2 (<code>R2</code>) is a half turn.</p><p>Try all 18 moves with the pad under the cube or press the letter keys (Shift = prime).</p>`,[['Try it',"R U R' U'"]],'Made a slip? The Undo button reverses your last move.','Turning anticlockwise when you see a plain letter – plain means clockwise.'],
['Step 1','White Cross',`<p>Build a white “+” on the <b>bottom</b>. Each white edge must also match the side centre colour. Bring a white edge to the top layer, turn U until its side colour sits above the matching centre, then turn that face twice.</p>`,[['Insert edge (F face)','F2']],'Solve the cross by sight – no algorithm needed.','Placing white edges without matching the side centres.'],
['Step 2','White Corners',`<p>Put a white corner in the top layer directly above its slot (front-right) and repeat the trigger until it drops in with white facing down. Do this for all four corners to finish the white face and first layer.</p>`,[['Corner trigger',"R U R' U'"]],'Repeat 1–5 times until the corner is correct.','Not lining up the corner above its slot before repeating.'],
['Step 3','Middle Layer',`<p>Find a top-layer edge with <b>no yellow</b>. Turn U so its front colour matches the front centre. If it belongs right, use the right algorithm; if left, the left one.</p>`,[['Move edge right',"U R U' R' U' F' U F"],['Move edge left',"U' L' U L U F U' F'"]],'A wrongly placed middle edge? Do the algorithm on it to pop it out first.','Using the wrong direction – check where the edge’s top colour belongs.'],
['Step 4','Yellow Cross',`<p>Make a yellow cross on top. You will see a dot, an “L” or a line. Hold the L at back-left (or the line horizontal) and repeat the algorithm until the cross appears.</p>`,[['Yellow cross',"F R U R' U' F'"]],'Dot → L → line → cross: at most three repeats.','Holding the cube the wrong way – match the L/line position first.'],
['Step 5','Position Yellow Edges',`<p>Turn U until at least two yellow-cross edges match their side centres. If two matched edges are adjacent, put them at back and right and run the algorithm; repeat until all four match.</p>`,[['Swap edges',"R U R' U R U2 R' U"]],'Two opposite matches? Do it once from any side, then recheck.','Forgetting to turn U before checking matches.'],
['Step 6','Position Yellow Corners',`<p>Ignore the yellow facing. Find a corner already in its correct spot (it sits between its three centre colours). Hold it front-right and repeat the algorithm until all corners are placed.</p>`,[['Place corners',"U R U' L' U R' U' L"]],'No corner correct? Do the algorithm once from any angle.','Judging by yellow – use the other two colours.'],
['Step 7','Orient Yellow Corners',`<p>Hold an unsolved corner at front-right. Repeat the algorithm until yellow faces up – the cube looks scrambled midway, keep going! Then turn only U to bring the next corner to front-right. Never rotate the whole cube.</p>`,[['Twist corner',"R' D' R D"]],'Trust the process: the cube is solved after the last corner.','Turning the whole cube between corners instead of just the U layer.']];
const TIPS=['Learn notation first – every guide uses it.','Slow, accurate turns beat fast, sloppy ones.','Look at the centres: they are your colour reference.','Practise algorithms until your fingers know them.','Solve in short sessions; speed comes with sleep.'];
const A0=[
['Beginner','Sexy move',"R U R' U'",'White corners; building block of many algs'],
